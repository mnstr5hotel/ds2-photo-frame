{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ds2-photo-frame",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": true
  }
}
