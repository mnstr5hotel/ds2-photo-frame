{
  "name": "ds2-photo-frame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node tools/harden-dist.mjs",
    "build:next": "next build",
    "build:node": "node tools/build-node.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:node": "node .next-node/standalone/server.js",
    "check": "node --check site/app.js && node --check site/lang.js && node tools/preflight.mjs",
    "smoke": "node tools/browser-smoke.mjs",
    "prepare:deploy": "node tools/prepare-deploy-source.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@vinext/cloudflare": "1.0.0-beta.5",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "playwright-core": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.1"
  }
}
